{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "aegis": {
      "type": "local",
      "command": [
        "/absolute/path/to/audit_mcp/.venv/bin/python",
        "-m",
        "aegis_mcp.server"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "AEGIS_TARGETS": "/absolute/path/to/audit_mcp/targets.yaml",
        "AEGIS_WORKSPACE": "/absolute/path/to/audit_mcp/.runtime",
        "AEGIS_ALLOW_APPLY": "0"
      }
    }
  }
}
